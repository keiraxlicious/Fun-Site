/* Overlay Panel Styles */

/* Panel Container */
.panel-header {
    font-family: var(--font-main);
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  
  .panel-title {
    font-family: var(--font-main);
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    color: #f0f0f0;
  }
  
  .panel-section {
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  
  /* Category Selector */
  .category-selector {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }
  
  .category-tab {
    font-family: var(--font-main);
    padding: 6px 12px;
    border: none;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .category-tab.active {
    background-color: rgba(102, 187, 255, 0.2);
    color: #66bbff;
    font-weight: 500;
  }
  
  .category-tab:hover {
    background-color: rgba(255, 255, 255, 0.12);
  }
  
  /* Effect Selector */
  .effect-selector {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 300px;
    overflow-y: auto;
  }
  
  .effect-option {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 6px;
    transition: all 0.2s ease;
  }
  
  .effect-option:hover {
    background-color: rgba(255, 255, 255, 0.08);
  }
  
  .effect-option.active {
    background-color: rgba(102, 187, 255, 0.15);
    border-left: 3px solid #66bbff;
  }
  
  .effect-info {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  
  .effect-icon {
    font-family: var(--font-main);
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.7);
    font-size: 16px;
  }
  
  .effect-name {
    font-family: var(--font-main);
    font-size: 14px;
    color: rgba(255, 255, 255, 0.9);
  }
  
  .effect-actions {
    display: flex;
    gap: 8px;
  }
  
  .effect-actions button {
    font-family: var(--font-main);
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  
  .apply-btn {
    background-color: rgba(102, 187, 255, 0.2) !important;
    color: #66bbff !important;
  }
  
  .apply-btn:hover {
    background-color: rgba(102, 187, 255, 0.3) !important;
  }
  
  .view-btn:hover, .disable-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }
  
  .disable-effect {
    margin-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 12px;
  }
  
  .disable-btn {
    color: rgba(255, 120, 120, 0.8) !important;
    border-color: rgba(255, 120, 120, 0.3) !important;
  }
  
  .no-effects-message {
    padding: 16px;
    text-align: center;
    color: rgba(255, 255, 255, 0.5);
    font-style: italic;
  }
  
  /* Render Mode Selector */
  .render-mode-title {
    font-family: var(--font-main);
    margin: 0 0 12px 0;
    font-size: 16px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.8);
  }
  
  .render-mode-options {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  
  .render-mode-option {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background-color: rgba(255, 255, 255, 0.05);
    border: none;
    border-radius: 6px;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
  }
  
  .render-mode-option:hover {
    background-color: rgba(255, 255, 255, 0.08);
  }
  
  .render-mode-option.active {
    background-color: rgba(102, 187, 255, 0.15);
    border-left: 3px solid #66bbff;
  }
  
  .mode-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    font-size: 16px;
  }
  
  .mode-name {
    font-family: var(--font-main);
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
  }
  
  .mode-description {
    font-family: var(--font-main);
    margin-left: auto;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
  }
  
  /* Icons for effects */
  .icon-snow::before { content: "❄️"; }
  .icon-rain::before { content: "🌧️"; }
  .icon-leaf::before { content: "🍂"; }
  .icon-sakura::before { content: "🌸"; }
  .icon-money::before { content: "💰"; }
  .icon-star::before { content: "⭐"; }
  .icon-heart::before { content: "❤️"; }
  .icon-bubble::before { content: "🫧"; }
  .icon-firefly::before { content: "✨"; }
  .icon-cloud::before { content: "☁️"; }
  .icon-disable::before { content: "🚫"; }
  .icon-default::before { content: "🔮"; }
  