.profile-card {
    position: relative;
    z-index: 10;
    width: 80%;
    max-width: 800px;
    background-color: var(--card-bg);
    border-radius: 20px;
    padding: 40px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(10px);
    border: 2px solid var(--color-turquoise);
}

.profile-picture {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    margin: 0 auto 20px;
    background-image: url('/assets/images/profile-picture.webp');
    background-size: cover;
    background-position: center;
    border: 4px solid var(--color-gold);
    box-shadow: 0 0 20px var(--color-pink);
    animation: float 6s ease-in-out infinite;
}

.profile-name {
    font-size: 36px;
    margin-bottom: 10px;
    color: var(--color-pink);
    text-shadow: 0 0 10px rgba(255, 154, 210, 0.5);
}

.profile-title {
    font-size: 24px;
    margin-bottom: 5px;
    color: var(--color-turquoise);
}

.profile-subtitle {
    font-size: 20px;
    margin-bottom: 30px;
    color: var(--color-gold);
}

.search-container {
    width: 80%;
    margin: 0 auto 30px;
}

#search-box {
    width: 100%;
    padding: 12px 20px;
    border-radius: 30px;
    border: 2px solid var(--color-teal);
    background-color: rgba(0, 0, 0, 0.3);
    color: white;
    font-size: 16px;
    outline: none;
    transition: all 0.3s ease;
}
